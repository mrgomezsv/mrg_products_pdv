<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_inherit_pos_config" model="ir.ui.view">
        <field name="name">product.template.form.inherit.pos.config</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="point_of_sale.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='available_in_pos']" position="after">
                <field name="pos_config_ids"
                       widget="many2many_tags"
                       options="{'no_create': True}"
                       invisible="not available_in_pos"/>
            </xpath>
        </field>
    </record>
</odoo>

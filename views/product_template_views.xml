<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_inherit_pos_config" model="ir.ui.view">
        <field name="name">product.template.form.inherit.pos.config</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="point_of_sale.product_template_form_view"/>
        <field name="arch" type="xml">
            <!-- Insertar en el grupo 'pos' dentro de la pestaña Ventas en Odoo 16 -->
            <xpath expr="//group[@name='pos']" position="inside">
                <field name="pos_config_ids"
                       widget="many2many_tags"
                       options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>
</odoo>


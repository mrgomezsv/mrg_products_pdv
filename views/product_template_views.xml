<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_inherit_pos_config" model="ir.ui.view">
        <field name="name">product.template.form.inherit.pos.config</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="point_of_sale.product_template_form_view"/>
        <field name="arch" type="xml">
            <!-- Insertar en la pestaña 'Punto de venta' de POS -->
            <xpath expr="//page[@name='pos']" position="inside">
                <group string="Restricción por PDV">
                    <group>
                        <field name="pos_config_ids"
                               widget="many2many_tags"
                               options="{'no_create': True}"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>

